{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [{ "type": "command", "command": "bash scripts/check-branch.sh" }]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [{ "type": "command", "command": "bash scripts/guard-edit.sh" }]
      }
    ]
  }
}
